# ===== Host port map (all selected free at scaffold time) =====
HOST_POSTGRES_PORT=5532
HOST_REDIS_PORT=6479
HOST_LITELLM_PORT=4400
HOST_TYPESENSE_PORT=8208
HOST_API_PORT=8800
HOST_WEB_PORT=3300
HOST_WS_PORT=8801
HOST_AGENT_PORT=8802

# ===== Postgres =====
POSTGRES_USER=buildagent
POSTGRES_PASSWORD=buildagent
POSTGRES_DB=buildagent
# Inside docker network use service hostnames
DATABASE_URL=postgresql+asyncpg://buildagent:buildagent@postgres:5432/buildagent

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== JWT (user auth) =====
JWT_SECRET=change-me-in-prod-please-32-chars-min
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ===== Service-to-service shared tokens =====
# Every service must present a token to be accepted by every other service.
NODE_TOKEN=change-me-node-shared-secret
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# ===== LiteLLM =====
LITELLM_MASTER_KEY=sk-buildagent-master
LITELLM_URL=http://litellm:4000

# ===== Typesense =====
TYPESENSE_API_KEY=buildagent-typesense
TYPESENSE_URL=http://typesense:8108

# ===== Provider keys (optional, plumbed into LiteLLM) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ===== Web (Next.js public) =====
NEXT_PUBLIC_API_URL=http://localhost:8800
NEXT_PUBLIC_WS_URL=ws://localhost:8800/ws

# ===== CORS =====
CORS_ORIGINS=http://localhost:3300
