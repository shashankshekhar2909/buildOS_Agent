{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuildAgent",
  "version": "0.0.1",
  "identifier": "io.buildagent.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3300",
    "frontendDist": "../../dashboard-web/.next/standalone"
  },
  "app": {
    "windows": [
      {
        "title": "BuildAgent",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "BuildAgent native shell",
    "longDescription": "Native desktop shell for BuildAgent — AI-native personal OS dashboard."
  }
}
